{
  "name": "@valerypopoff/rivet",
  "license": "MIT",
  "repository": "https://github.com/valerypopoff/rivet2.0",
  "packageManager": "yarn@4.17.1",
  "workspaces": [
    "packages/*"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --max-old-space-size=8192 .yarn/releases/yarn-4.17.1.cjs workspace @valerypopoff/rivet-app run dev",
    "docs": "node .yarn/releases/yarn-4.17.1.cjs workspace docs run",
    "build": "node --max-old-space-size=8192 .yarn/releases/yarn-4.17.1.cjs workspace @valerypopoff/rivet2-core run build && node --max-old-space-size=8192 .yarn/releases/yarn-4.17.1.cjs workspace @valerypopoff/rivet2-node run build && node --max-old-space-size=8192 .yarn/releases/yarn-4.17.1.cjs workspace @valerypopoff/rivet-app-executor run build && node --max-old-space-size=8192 .yarn/releases/yarn-4.17.1.cjs workspace @valerypopoff/rivet2-evaluations run build && node --max-old-space-size=8192 .yarn/releases/yarn-4.17.1.cjs workspace @valerypopoff/rivet-app run build && node --max-old-space-size=8192 .yarn/releases/yarn-4.17.1.cjs workspace @valerypopoff/rivet2-cli run build",
    "build:all": "npm run build",
    "build:runtime": "node scripts/build-wrapper-target.mjs runtime",
    "build:hosted-web-deps": "node scripts/build-wrapper-target.mjs hosted-web-deps",
    "build:executor-runtime": "node scripts/build-wrapper-target.mjs executor-runtime",
    "build:npm-public": "node scripts/build-wrapper-target.mjs npm-public",
    "build:packages:local": "node scripts/create-built-package-artifacts.mjs",
    "bench:build-timing": "node scripts/measure-build-phases.mjs",
    "sync:desktop-version": "node scripts/sync-desktop-version.mjs",
    "verify:desktop-version": "node scripts/sync-desktop-version.mjs --check",
    "publish": "node scripts/publish-npm-packages.mjs",
    "test": "yarn test:core && yarn test:node && yarn test:evaluations && yarn test:app && yarn test:app-executor && yarn test:cli",
    "test:all": "yarn test",
    "test:core": "yarn workspace @valerypopoff/rivet2-core run test",
    "test:node": "yarn workspace @valerypopoff/rivet2-node run test",
    "test:evaluations": "yarn workspace @valerypopoff/rivet2-evaluations run test",
    "test:app": "yarn workspace @valerypopoff/rivet-app run test",
    "test:app-executor": "yarn workspace @valerypopoff/rivet-app-executor run test",
    "test:cli": "yarn workspace @valerypopoff/rivet2-cli run test",
    "test:docs": "yarn workspace docs run typecheck",
    "test:style": "node scripts/checks/check-pnp-install-state.mjs && node scripts/publish-npm-packages.mjs --check-versions && node scripts/checks/check-test-style.mjs && node --test scripts/checks/check-dependency-audit.test.mjs scripts/checks/check-rust-audit-exceptions.test.mjs && tsx --test scripts/checks/check-graph-builder-policy.test.mjs && yarn check:graph-builder-assets && tsx --test scripts/checks/check-graph-builder-evaluation.test.mjs && tsx scripts/checks/check-graph-builder-evaluation.mjs && yarn check:promo-catalog && node scripts/checks/check-doc-links.mjs && node scripts/checks/check-rich-text-sinks.mjs && node scripts/checks/check-ai-runtime-boundaries.mjs && node scripts/checks/check-desktop-shell-contract.mjs && node scripts/checks/check-editor-boundaries.mjs && yarn workspace @valerypopoff/rivet2-node run check:web-app-client",
    "security:audit": "node scripts/checks/check-dependency-audit.mjs",
    "security:audit:rust-exceptions": "node scripts/checks/check-rust-audit-exceptions.mjs",
    "check:file-tree": "node scripts/checks/check-file-tree.mjs",
    "check:graph-builder-policy": "tsx scripts/checks/check-graph-builder-policy.mjs",
    "check:graph-builder-node-specs": "yarn workspace @valerypopoff/rivet2-core run build:esm && tsx scripts/checks/check-graph-builder-node-specs.mjs",
    "check:graph-builder-assets": "node scripts/checks/check-legacy-graph-creator-rollback.mjs && yarn check:graph-builder-policy && yarn check:graph-builder-node-specs",
    "check:graph-builder-evaluation": "tsx scripts/checks/check-graph-builder-evaluation.mjs",
    "check:promo-catalog": "tsx scripts/checks/check-promo-catalog.mts",
    "check:pnp": "node scripts/checks/check-pnp-install-state.mjs",
    "check:npm-publish-versions": "node scripts/publish-npm-packages.mjs --check-versions",
    "bench:runtime-speed": "yarn workspace @valerypopoff/rivet2-node run bench:runtime-speed",
    "bench:runtime-attribution": "yarn workspace @valerypopoff/rivet2-node run bench:runtime-attribution",
    "lint": "yarn workspace @valerypopoff/rivet2-core run lint && yarn workspace @valerypopoff/rivet2-node run lint && yarn workspace @valerypopoff/rivet-app run lint && yarn workspace @valerypopoff/rivet2-evaluations run lint && yarn workspace @valerypopoff/rivet-app-executor run lint && yarn workspace @valerypopoff/rivet2-cli run lint",
    "prettier:check": "prettier --check package.json \"scripts/checks/*.{mjs,mts}\"",
    "prettier:fix": "prettier --write ."
  },
  "devDependencies": {
    "@octokit/rest": "^20.0.2",
    "@swc/core": "^1.15.43",
    "@types/node": "^22.20.1",
    "@types/yargs": "^17.0.29",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "chalk": "^5.3.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.20.1",
    "eslint-config-standard-with-typescript": "^39.1.1",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^16.2.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.2.5",
    "rollup": "^4.62.2",
    "ts-node": "^10.9.1",
    "tsx": "^4.23.0",
    "typescript": "^5.7.3",
    "yargs": "^17.7.2",
    "zx": "^8.5.4"
  },
  "resolutions": {
    "jest-mock": "^28.1.0",
    "@types/react": "18.2.31",
    "esbuild": "0.25.12",
    "flatted": "^3.4.2",
    "form-data": "^4.0.6",
    "axios": "^1.18.1",
    "jws": "^4.0.1",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "brace-expansion@npm:^1.1.7": "1.1.18",
    "brace-expansion@npm:^2.0.2": "2.1.4",
    "brace-expansion@npm:^5.0.5": "5.0.9",
    "brace-expansion@npm:^5.0.8": "5.0.9",
    "fast-uri@npm:^3.0.1": "4.1.2",
    "js-yaml@npm:^3.13.1": "3.15.1",
    "js-yaml@npm:^4.1.0": "4.3.1",
    "minimatch@npm:^3.1.2": "3.1.5",
    "ip-address@npm:^10.2.0": "10.4.0",
    "minimatch@npm:^9.0.4": "9.0.9",
    "nanoid@npm:^3.3.16": "3.3.18",
    "node-gyp@npm:latest": "12.4.0",
    "tar@npm:^7.5.4": "7.5.22",
    "path-to-regexp@npm:^8.0.0": "^8.4.2",
    "picomatch@npm:^2.0.0": "^2.3.2",
    "postcss@npm:^8.4.21": "8.5.22",
    "shell-quote": "^1.9.0",
    "socks": "^2.8.9",
    "svgo@npm:^3.0.2": "3.3.4",
    "svgo@npm:^3.2.0": "3.3.4",
    "tsx": "^4.23.0",
    "underscore": "^1.13.8",
    "ws": "^8.21.0",
    "image-size@npm:^2.0.2": "patch:image-size@npm%3A2.0.2#~/.yarn/patches/image-size-npm-2.0.2-43abbcfb5c.patch"
  },
  "volta": {
    "node": "22.21.1",
    "yarn": "4.17.1"
  },
  "dependencies": {
    "@valerypopoff/rivet2-core": "workspace:^",
    "@valerypopoff/rivet2-node": "workspace:^"
  }
}
