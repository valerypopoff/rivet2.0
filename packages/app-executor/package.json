{
  "name": "@valerypopoff/rivet-app-executor",
  "license": "MIT",
  "repository": "https://github.com/valerypopoff/rivet2.0",
  "version": "2.1.3",
  "bin": "./bin/executor-bundle.cjs",
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build-executor.mts",
    "dev": "tsx watch --inspect=9228 --experimental-network-imports bin/executor.mts",
    "test": "tsx --test bin/**/*.test.mts",
    "start": "yarn build && node --experimental-network-imports bin/executor-bundle.cjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@swc/core": "^1.15.43",
    "@types/yargs": "^17.0.29",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@valerypopoff/rivet2-core": "workspace:^",
    "@valerypopoff/rivet2-node": "workspace:^",
    "appdata-path": "^1.0.0",
    "chalk": "^5.3.0",
    "esbuild": "0.25.12",
    "esbuild-plugin-copy": "^2.1.1",
    "eslint": "^9.20.1",
    "eslint-config-standard-with-typescript": "^39.1.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^16.2.0",
    "eslint-plugin-promise": "^6.1.1",
    "execa": "^8.0.1",
    "pkg": "^5.8.1",
    "tsx": "^4.23.0",
    "type-fest": "^4.34.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "ts-pattern": "^5.6.2"
  },
  "volta": {
    "node": "22.22.3"
  }
