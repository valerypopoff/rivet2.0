            outputRequestBody: false
            outputRequestError: false
            outputRequestStatus: false
            outputResponseBody: false
            outputUsage: false
            parallelToolCalls: false
            provider: openai
            responseFormat: json_schema
            responseSchemaDescription: One GraphBuilderDecision for the current policy turn.
            responseSchemaName: graph_builder_decision
            retryOnNon200: false
            retryOnNon200CooldownMs: 0
            retryOnNon200RepeatTimes: 0
            stopSequences: []
            temperature: 0
            toolChoice: ""
            toolChoiceFunction: ""
            useAnthropicThinkingBudgetInput: false
            useAsGraphPartialOutput: false
            useBaseURLInput: false
            useCustomProviderBaseURLInput: false
            useExtraProviderOptionsInput: false
            useFrequencyPenaltyInput: false
            useGoogleThinkingBudgetInput: false
            useHeadersInput: false
            useMaxTokensInput: false
            useModelInput: false
            useOpenAIPreviousResponseIdInput: false
            usePresencePenaltyInput: false
            useResponseSchemaDescriptionInput: false
            useResponseSchemaNameInput: false
            useSeedInput: false
            useStopSequencesInput: false
            useTemperatureInput: false
            useToolCalling: false
            useTopKInput: false
            useTopPInput: false
