{
  "build": {
    "beforeBuildCommand": "node ../../.yarn/releases/yarn-4.17.1.cjs prepare:tauri && node ../../.yarn/releases/yarn-4.17.1.cjs build",
    "beforeDevCommand": "node ../../.yarn/releases/yarn-4.17.1.cjs prepare:tauri && node ../../.yarn/releases/yarn-4.17.1.cjs start",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Rivet 2",
    "version": "2.9.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": true,
        "readDir": true,
        "createDir": true,
        "removeDir": true,
        "exists": true,
        "scope": ["$APPLOCALDATA/**", "$APPLOCALDATA/**/.*", "$TEMP/**", "**", "**/*", "/**/*"]
      },
      "path": {
        "all": true
      },
      "dialog": {
        "all": false,
        "open": true,
        "save": true
      },
      "process": {
        "relaunch": true
      },
      "shell": {
        "sidecar": true,
        "open": true,
        "execute": true,
        "scope": [
          {
            "name": "../../app-executor/dist/app-executor",
            "sidecar": true
          },
          {
            "name": "npm",
            "args": true,
            "cmd": "npm",
            "sidecar": false
          },
          {
            "name": "../sidecars/pnpm/pnpm",
            "args": true,
            "cmd": "pnpm",
            "sidecar": true
          },
          {
            "name": "git",
            "args": true,
            "cmd": "git",
            "sidecar": false
          }
        ]
      },
      "window": {
        "all": false,
        "create": true,
        "center": true,
        "setAlwaysOnTop": true,
        "setTitle": true,
        "maximize": true,
        "unmaximize": true,
        "minimize": true,
        "close": true,
        "startDragging": true
      },
      "globalShortcut": {
        "all": true
      },
      "http": {
        "all": false,
        "request": true,
        "scope": ["https://*"]
      }
    },
    "bundle": {
      "active": true,
      "category": "DeveloperTool",
      "copyright": "",
      "deb": {
        "depends": []
      },
      "externalBin": ["../../app-executor/dist/app-executor", "../sidecars/pnpm/pnpm"],
      "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
      "identifier": "com.valerypopoff.rivet2",
      "longDescription": "",
      "macOS": {
        "entitlements": "../entitlements.plist",
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": null
      },
      "resources": [],
      "shortDescription": "",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": true,
      "endpoints": ["https://github.com/valerypopoff/rivet2.0/releases/latest/download/latest.json"],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwRTgxNDEzODJDREJDNzkKUldSNXZNMkNFeFRvUU5VK0NXdEIwNlc3NTREUWpNSmpaeGFwWjFwc21ZT0U5cFlzcy81QndDOXYK"
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 1024,
        "minHeight": 600,
        "minWidth": 800,
        "resizable": true,
        "title": "Rivet 2",
        "width": 1200
      }
    ]
  }
}
