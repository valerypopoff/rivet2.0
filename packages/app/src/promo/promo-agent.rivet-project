version: 4
data:
  graphs:
    promo-agent-main:
      metadata:
        description: An LLM calls a typed tool graph, receives its result, and writes the final answer.
        id: promo-agent-main
        name: LLM agent with a tool
      nodes:
        '[agent-api-key]:text "API Key — paste yours here"':
          data:
            text: ""
          outgoingConnections:
            - output->"Launch coach" agent-llm/apiKey
          visualData: 80/100/330/1//
        '[agent-task]:text "Try this request"':
          data:
            text: |-
              You are a concise launch coach. Plan a small launch for a neighborhood bakery's weekend bread subscription, aimed at busy neighbors.

              Call buildLaunchChecklist exactly once, then turn its result into a short final answer with three clearly labeled steps.
          outgoingConnections:
            - output->"Launch coach" agent-llm/prompt
          visualData: 80/390/330/2//
        '[agent-tool]:gptFunction "Tool — build launch checklist"':
          data:
            description: Build a deterministic three-step launch checklist for a product and audience.
            name: buildLaunchChecklist
            resultHandling: continue
            schema: |-
              {
                "type": "object",
                "properties": {
                  "product": { "type": "string", "description": "The offer being launched" },
                  "audience": { "type": "string", "description": "The intended customer" }
                },
                "required": ["product", "audience"],
                "additionalProperties": false
              }
          outgoingConnections:
            - function->"Launch coach" agent-llm/functions
          visualData: 500/680/370/3//
        '[agent-llm]:llmChatV2 "Launch coach"':
          data:
            anthropicCacheControlTtl: ""
            anthropicEffort: ""
            anthropicThinkingMode: ""
            apiKeySource: input
            autoContinueToolCalls: true
            baseURL: ""
            cache: false
            configurationMode: inline
            customProviderApiKeyEnvVarName: CUSTOM_PROVIDER_API_KEY
            customProviderApiKeyProgrammaticName: ""
            customProviderBaseURL: ""
            enableGoogleSearchGrounding: false
            enableGoogleUrlContext: false
            enableOpenAICodeInterpreter: false
            enableOpenAIWebSearch: false
            extraProviderOptions: ""
            googleIncludeThoughts: false
            googleThinkingLevel: ""
            headers: []
            maxTokens: 500
            maxToolRounds: 1
            model: gpt-4o-mini
            openAIPreviousResponseId: ""
            openAIReasoningEffort: ""
            openAIReasoningSummary: ""
            openAIWebSearchContextSize: medium
            outputReasoning: false
            outputRequestBody: false
            outputRequestError: false
            outputRequestStatus: false
            outputUsage: false
            parallelToolCalls: false
            provider: openai
            responseFormat: text
            responseSchemaDescription: ""
            responseSchemaName: ""
            retryOnNon200: false
            retryOnNon200CooldownMs: 0
            retryOnNon200RepeatTimes: 0
            stopSequences: []
            temperature: 0.2
            toolChoice: function
            toolChoiceFunction: buildLaunchChecklist
            useAnthropicThinkingBudgetInput: false
            useAsGraphPartialOutput: false
            useBaseURLInput: false
            useCustomProviderBaseURLInput: false
            useExtraProviderOptionsInput: false
            useFrequencyPenaltyInput: false
            useGoogleThinkingBudgetInput: false
            useHeadersInput: false
            useMaxTokensInput: false
            useModelInput: false
            useOpenAIPreviousResponseIdInput: false
            usePresencePenaltyInput: false
            useResponseSchemaDescriptionInput: false
            useResponseSchemaNameInput: false
            useSeedInput: false
            useStopSequencesInput: false
            useTemperatureInput: false
            useToolCalling: true
            useTopKInput: false
            useTopPInput: false
          outgoingConnections:
            - function-calls->"Delegate tool call" agent-delegate/function-call
            - response->"Final answer" agent-output/value
          visualData: 980/330/340/4//
        '[agent-delegate]:delegateFunctionCall "Delegate tool call"':
          data:
            autoDelegate: true
            fallBackToExternalCall: false
            handlers: []
            passthroughErrors: false
          visualData: 1430/650/350/5//
        '[agent-output]:graphOutput "Final answer"':
          data:
            dataType: string
            id: output
          visualData: 1430/330/330/6//
    promo-agent-tool:
      metadata:
        description: Deterministic tool graph invoked by the LLM agent.
        id: promo-agent-tool
        name: buildLaunchChecklist
      nodes:
        '[tool-product]:graphInput "Product"':
          data:
            dataType: string
            id: product
            useDefaultValueInput: false
          outgoingConnections:
            - data->"Build checklist" tool-checklist/product
          visualData: 80/170/300/1//
        '[tool-audience]:graphInput "Audience"':
          data:
            dataType: string
            id: audience
            useDefaultValueInput: false
          outgoingConnections:
            - data->"Build checklist" tool-checklist/audience
          visualData: 80/470/300/2//
        '[tool-checklist]:text "Build checklist"':
          data:
            text: |-
              Product: {{product}}
              Audience: {{audience}}

              1. Promise — state one concrete customer benefit.
              2. Proof — run one small real-world test with the target audience.
              3. Next step — measure sign-ups and improve the weakest part.
          outgoingConnections:
            - output->"Tool result" tool-output/value
          visualData: 510/280/440/3//
        '[tool-output]:graphOutput "Tool result"':
          data:
            dataType: string
            id: output
          visualData: 1070/350/300/4//
  metadata:
    description: Paste an OpenAI API key, then watch an LLM call a typed tool graph and use its result in a final answer.
    id: rivet-promo-agent
    mainGraphId: promo-agent-main
    title: Demo — LLM Agent
  plugins: []
