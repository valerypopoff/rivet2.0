          visualData: -246.41592920353983/-257.49568249693306/264.4020619469027/58/transparent/var(--node-color-4)
        '[visual-code]:codeNew "Code - Route and calculate reimbursement"':
          data:
            allowConsole: false
            allowFetch: false
            allowProcess: false
            allowRequire: false
            allowRivet: false
            code: >-
              const amount = Number({{amount}});

              const policyEligible = Boolean({{policyEligible}});


              // Keep the simple policy checks on the canvas. This tiered
              routing

              // table is clearer as one focused calculation than as a dense
              tree

              // of comparison, branch, lookup, and rounding nodes.

              const tiers = [
                { upperBound: 250, route: 'Team lead', handlingRate: 0.02 },
                { upperBound: 750, route: 'Finance', handlingRate: 0.04 },
                { upperBound: 1000, route: 'Finance + Travel desk', handlingRate: 0.08 },
              ];


              if (!policyEligible) {
                return '# Expense decision\n\n**Needs review**\n\nThe request did not pass the visible policy gates.';
              }


              const tier = tiers.find(({ upperBound }) => amount <= upperBound)
              ?? tiers.at(-1);

              const reimbursableAmount = Math.round(amount * (1 +
              tier.handlingRate) * 100) / 100;


              return [
                '# Expense decision',
                '',
                '**Auto-approve**',
                '',
                `- Route to: **${tier.route}**`,
                `- Reimbursable amount: **$${reimbursableAmount.toFixed(2)}**`,
                `- Handling rate: **${tier.handlingRate * 100}%**`,
              ].join('\n');
          outgoingConnections:
            - output->"Graph output" visual-output/value
          visualData: 1445.6194690265488/-569.8672566371681/610.4406678682076/51//
