version: 4
data:
  graphs:
    promo-web-app-main:
      metadata:
        description: A compact LLM workflow behind a conventional form-and-result web app.
        id: promo-web-app-main
        name: Generate a launch brief
      nodes:
        '[web-api-key]:text "API Key - paste yours here"':
          data:
            text: ""
          outgoingConnections:
            - output->"Launch brief generator" web-llm/apiKey
          visualData: 60/110/330/1//
        '[web-product-idea]:graphInput "Product idea"':
          data:
            dataType: string
            id: productIdea
            useDefaultValueInput: false
          outgoingConnections:
            - data->"Build launch brief prompt" web-prompt/productIdea
          visualData: 60/420/330/2//
        '[web-audience]:graphInput "Target customer"':
          data:
            dataType: string
            id: audience
            useDefaultValueInput: false
          outgoingConnections:
            - data->"Build launch brief prompt" web-prompt/audience
          visualData: 60/680/330/3//
        '[web-system]:text "Brief instructions"':
          data:
            text: |-
              You are a practical product strategist. Write concise, concrete Markdown.
              Do not invent customer research or market facts.
          outgoingConnections:
            - output->"Launch brief generator" web-llm/systemPrompt
          visualData: 520/100/370/4//
        '[web-prompt]:text "Build launch brief prompt"':
          data:
            text: |-
              Product idea:
              {{productIdea}}

              Target customer:
              {{audience}}

              Create a launch brief with these headings:
              ## Positioning
              ## First-use experience
              ## Three launch messages
              ## One execution risk
          outgoingConnections:
            - output->"Launch brief generator" web-llm/prompt
          visualData: 520/510/390/5//
        '[web-llm]:llmChatV2 "Launch brief generator"':
          data:
            anthropicCacheControlTtl: ""
            anthropicEffort: ""
            anthropicThinkingMode: ""
            apiKeySource: input
            autoContinueToolCalls: false
            baseURL: ""
            cache: false
            configurationMode: inline
            customProviderApiKeyEnvVarName: CUSTOM_PROVIDER_API_KEY
            customProviderApiKeyProgrammaticName: ""
            customProviderBaseURL: ""
            enableGoogleSearchGrounding: false
            enableGoogleUrlContext: false
            enableOpenAICodeInterpreter: false
            enableOpenAIWebSearch: false
            extraProviderOptions: ""
            googleIncludeThoughts: false
            googleThinkingLevel: ""
            headers: []
            maxTokens: 350
            maxToolRounds: 1
            model: gpt-4o-mini
            openAIPreviousResponseId: ""
            openAIReasoningEffort: ""
            openAIReasoningSummary: ""
            openAIWebSearchContextSize: medium
            outputReasoning: false
            outputRequestBody: false
            outputLLMAttempts: false
            outputUsage: false
            parallelToolCalls: false
            provider: openai
            responseFormat: text
            responseSchemaDescription: ""
            responseSchemaName: ""
            retryOnNon200: false
            retryOnNon200CooldownMs: 0
            retryOnNon200RepeatTimes: 0
            stopSequences: []
            temperature: 0.4
            toolChoice: ""
            toolChoiceFunction: ""
            useAnthropicThinkingBudgetInput: false
            useAsGraphPartialOutput: false
            useBaseURLInput: false
            useCustomProviderBaseURLInput: false
            useExtraProviderOptionsInput: false
            useFrequencyPenaltyInput: false
            useGoogleThinkingBudgetInput: false
            useHeadersInput: false
            useMaxTokensInput: false
            useModelInput: false
            useOpenAIPreviousResponseIdInput: false
            usePresencePenaltyInput: false
            useResponseSchemaDescriptionInput: false
            useResponseSchemaNameInput: false
            useSeedInput: false
            useStopSequencesInput: false
            useTemperatureInput: false
            useToolCalling: false
            useTopKInput: false
            useTopPInput: false
          outgoingConnections:
            - response->"Launch brief" web-output/value
          visualData: 1030/390/350/6//
        '[web-output]:graphOutput "Launch brief"':
          data:
            dataType: string
            id: output
          visualData: 1510/440/330/7//
  metadata:
    description: Paste an OpenAI API key in the workflow, then open the bundled launch-brief web app.
    id: rivet-promo-web-app
    mainGraphId: promo-web-app-main
    title: Demo - Web App
  plugins: []
  uiGraphs:
    promo-web-app-ui:
      components:
        - id: promo-web-app-heading
          markdown: |-
            ## Product launch brief

            Turn a product idea into a compact launch brief with an ordinary form and a rendered result.
          type: markdown
        - defaultValue: A collaborative weekly-planning tool that turns notes, deadlines, and team availability into a realistic plan.
          id: promo-web-app-product-idea
          label: Product idea
          placeholder: Describe the product or feature...
          stateKey: productIdea
          type: textarea
        - defaultValue: Product managers at growing B2B SaaS companies
          id: promo-web-app-audience
          label: Target customer
          placeholder: Who is this for?
          stateKey: audience
          type: input
        - action:
            graphId: promo-web-app-main
            inputMappings:
              - inputKey: productIdea
                stateKey: productIdea
              - inputKey: audience
                stateKey: audience
            outputs:
              - outputKey: output
                stateKey: launchBrief
            type: runGraph
          id: promo-web-app-generate
          label: Generate launch brief
          type: button
        - id: promo-web-app-output
          label: Launch brief
          renderAs: markdown
          stateKey: launchBrief
          type: output
      id: promo-web-app-ui
      name: Launch brief web app - open this
