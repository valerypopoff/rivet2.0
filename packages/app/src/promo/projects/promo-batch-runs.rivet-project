version: 4
data:
  graphs:
    promo-batch-runs-main:
      metadata:
        description: One LLM node classifies three requests as separate parallel, inspectable runs.
        id: promo-batch-runs-main
        name: One node, many inspectable runs
      nodes:
        '[batch-api-key]:text "API Key — paste yours here"':
          data:
            text: ""
          outgoingConnections:
            - output->"Classify requests" batch-llm/apiKey
          visualData: 70/110/330/1//
        '[batch-requests]:graphInput "Three customer requests"':
          data:
            dataType: string[]
            defaultValue:
              - I was charged twice for my monthly plan.
              - The dashboard stays blank after I sign in.
              - Please add a dark mode for late-night work.
            editor: stringList
            id: requests
            useDefaultValueInput: false
          outgoingConnections:
            - data->"Classify requests" batch-llm/prompt
          visualData: 70/440/390/2//
        '[batch-instructions]:text "Classification instructions"':
          data:
            text: |-
              Classify the customer request as Billing, Technical, or Feature request.
              Reply with only the category and one short reason.
          outgoingConnections:
            - output->"Classify requests" batch-llm/systemPrompt
          visualData: 550/440/390/3//
        '[batch-llm]:llmChatV2 "Classify requests"':
          data:
            anthropicCacheControlTtl: ""
            anthropicEffort: ""
            anthropicThinkingMode: ""
            apiKeySource: input
            autoContinueToolCalls: false
            baseURL: ""
            cache: false
            configurationMode: inline
            customProviderApiKeyEnvVarName: CUSTOM_PROVIDER_API_KEY
            customProviderApiKeyProgrammaticName: ""
            customProviderBaseURL: ""
            enableGoogleSearchGrounding: false
            enableGoogleUrlContext: false
            enableOpenAICodeInterpreter: false
            enableOpenAIWebSearch: false
            extraProviderOptions: ""
            googleIncludeThoughts: false
            googleThinkingLevel: ""
            headers: []
            maxTokens: 80
            maxToolRounds: 1
            model: gpt-4o-mini
            openAIPreviousResponseId: ""
            openAIReasoningEffort: ""
            openAIReasoningSummary: ""
            openAIWebSearchContextSize: medium
            outputReasoning: false
            outputRequestBody: false
            outputLLMAttempts: false
            outputUsage: false
            parallelToolCalls: false
            provider: openai
            responseFormat: text
            responseSchemaDescription: ""
            responseSchemaName: ""
            retryOnNon200: false
            retryOnNon200CooldownMs: 0
            retryOnNon200RepeatTimes: 0
            stopSequences: []
            temperature: 0
            toolChoice: ""
            toolChoiceFunction: ""
            useAnthropicThinkingBudgetInput: false
            useAsGraphPartialOutput: false
            useBaseURLInput: false
            useCustomProviderBaseURLInput: false
            useExtraProviderOptionsInput: false
            useFrequencyPenaltyInput: false
            useGoogleThinkingBudgetInput: false
            useHeadersInput: false
            useMaxTokensInput: false
            useModelInput: false
            useOpenAIPreviousResponseIdInput: false
            usePresencePenaltyInput: false
            useResponseSchemaDescriptionInput: false
            useResponseSchemaNameInput: false
            useSeedInput: false
            useStopSequencesInput: false
            useTemperatureInput: false
            useToolCalling: false
            useTopKInput: false
            useTopPInput: false
          isSplitRun: true
          outgoingConnections:
            - response->"Classifications" batch-output/value
          visualData: 1030/300/360/4//
        '[batch-output]:graphOutput "Classifications"':
          data:
            dataType: string[]
            id: output
          visualData: 1510/360/330/5//
  metadata:
    description: Paste an OpenAI API key, then inspect three parallel runs inside one LLM node.
    id: rivet-promo-batch-runs
    mainGraphId: promo-batch-runs-main
    title: Demo — One Node, Many Runs
  plugins: []
