{
  "name": "@valerypopoff/rivet2-core",
  "license": "MIT",
  "repository": "https://github.com/valerypopoff/rivet2.0",
  "version": "2.4.0",
  "packageManager": "yarn@4.17.1",
  "main": "dist/cjs/bundle.cjs",
  "module": "dist/esm/index.js",
  "src": "src/index.ts",
  "type": "module",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/bundle.cjs"
      },
      "browser": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/bundle.cjs"
      },
      "default": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/bundle.cjs"
      }
    },
    "./web-app-runtime": {
      "types": "./dist/types/webAppRuntime.d.ts",
      "import": "./dist/esm/webAppRuntime.js",
      "require": "./dist/cjs/webAppRuntime.cjs"
    }
  },
  "files": [
    "dist/cjs/**",
    "dist/esm/**",
    "dist/types/**"
  ],
  "scripts": {
    "build": "yarn build:esm && yarn build:cjs",
    "build:esm": "rimraf dist/esm dist/types dist/tsconfig.tsbuildinfo && tsc -b --verbose",
    "build:cjs": "rimraf dist/cjs && node bundle.esbuild.cjs",
    "prepack": "yarn build && cp -r ../../LICENSE ../../README.md .",
    "lint": "eslint ./src",
    "test": "tsx --test test/**/*.test.ts",
    "watch": "tsc -b -w"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.58",
    "@ai-sdk/google": "3.0.43",
    "@ai-sdk/openai": "3.0.41",
    "@ai-sdk/openai-compatible": "1.0.17",
    "@gentrace/core": "^3.5.12",
    "@google-cloud/vertexai": "^1.12.0",
    "@google/genai": "^1.52.0",
    "@huggingface/inference": "^2.6.4",
    "acorn": "^8.14.0",
    "ai": "6.0.116",
    "assemblyai": "^4.6.0",
    "autoevals": "^0.3.0",
    "cron-parser": "^4.9.0",
    "crypto-js": "^4.2.0",
    "emittery": "^1.0.1",
    "emittery-0-13": "npm:emittery@^0.13.1",
    "gpt-tokenizer": "^2.1.2",
    "json-stream-es": "^1.2.1",
    "jsonpath-plus": "^10.4.0",
    "lodash-es": "^4.18.1",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-to-markdown": "^2.1.2",
    "minimatch": "^10.2.5",
    "mustache": "^4.2.0",
    "nanoid": "^3.3.18",
    "openai": "^4.28.4",
    "p-queue": "^7.4.1",
    "p-queue-6": "npm:p-queue@^6.0.0",
    "p-retry": "^6.1.0",
    "p-retry-4": "npm:p-retry@^4.0.0",
    "safe-stable-stringify": "^2.4.3",
    "ts-dedent": "^2.2.0",
    "ts-pattern": "^5.6.2",
    "type-fest": "^4.34.1",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@swc/core": "^1.15.43",
    "@types/crypto-js": "^4.1.3",
    "@types/eslint": "^8.44.6",
    "@types/lodash": "^4.14.200",
    "@types/lodash-es": "^4.17.10",
    "@types/mustache": "^4.2.6",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.20.1",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^16.2.0",
    "eslint-plugin-promise": "^6.1.1",
    "fake-indexeddb": "^6.2.4",
    "lodash": "^4.18.1",
    "prettier": "^3.2.5",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.1",
    "tsx": "^4.23.0",
    "typescript": "^5.7.3"
  },
  "volta": {
    "node": "22.21.1"
  }
}
