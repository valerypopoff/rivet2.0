{
  "name": "@valerypopoff/rivet2-node",
  "license": "MIT",
  "repository": "https://github.com/valerypopoff/rivet2.0",
  "version": "2.2.0",
  "main": "dist/cjs/bundle.cjs",
  "module": "dist/esm/index.js",
  "src": "src/index.ts",
  "types": "dist/types/index.d.ts",
  "type": "module",
  "exports": {
    "node": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/bundle.cjs"
    },
    "browser": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/bundle.cjs"
    },
    "default": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/bundle.cjs"
    }
  },
  "files": [
    "dist/cjs/**",
    "dist/esm/**",
    "dist/types/**"
  ],
  "scripts": {
    "build": "yarn build:web-app-client && yarn build:esm && yarn build:cjs",
    "build:web-app-client": "node scripts/build-web-app-client.cjs",
    "check:web-app-client": "node scripts/build-web-app-client.cjs --check",
    "build:esm": "rimraf dist/esm dist/types dist/tsconfig.tsbuildinfo && tsc -b --verbose",
    "build:cjs": "rimraf dist/cjs && node ../core/bundle.esbuild.cjs",
    "bench:debugger-transport": "tsx bench/debuggerTransport.bench.ts",
    "bench:runtime-attribution": "tsx bench/runtimeAttribution.bench.ts",
    "bench:runtime-speed": "yarn workspace @valerypopoff/rivet2-core run build:esm && tsx bench/runtimeSpeed.bench.ts",
    "prepack": "yarn build && cp -r ../../LICENSE ../../README.md .",
    "lint": "eslint ./src ./bench",
    "pretest": "yarn workspace @valerypopoff/rivet2-core run build:esm",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@valerypopoff/rivet2-core": "workspace:^",
    "dompurify": "^3.4.11",
    "emittery": "^1.0.1",
    "emittery-0-13": "npm:emittery@^0.13.1",
    "github-markdown-css": "^5.8.1",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "marked": "^9.1.2",
    "minimatch": "^10.2.5",
    "nanoid": "^3.3.16",
    "ts-pattern": "^5.6.2",
    "type-fest": "^4.34.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@swc/core": "^1.15.43",
    "@types/eslint": "^8.44.6",
    "@types/jsdom": "^28.0.3",
    "@types/lodash": "^4.14.200",
    "@types/lodash-es": "^4.17.10",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.5.8",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.20.1",
    "eslint-config-standard-with-typescript": "^39.1.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^16.2.0",
    "eslint-plugin-promise": "^6.1.1",
    "jsdom": "^26.1.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.1",
    "tsx": "^4.23.0",
    "typescript": "^5.7.3"
  },
  "volta": {
    "node": "22.21.1"
  }
}
