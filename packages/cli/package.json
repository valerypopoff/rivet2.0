{
  "name": "@valerypopoff/rivet2-cli",
  "license": "MIT",
  "repository": "https://github.com/valerypopoff/rivet2.0",
  "version": "2.0.11",
  "src": "src/cli.ts",
  "bin": {
    "rivet": "bin/cli.js"
  },
  "types": "dist/types/cli.d.ts",
  "type": "module",
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "yarn build",
    "publish": "yarn npm publish --access public",
    "verify": "yarn build && yarn lint && yarn test && yarn pack --dry-run",
    "docker-publish": "./docker-publish.sh",
    "lint": "eslint ./src",
    "test": "tsx --test test/**/*.test.ts",
    "start": "yarn build && node bin/cli.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@types/dotenv": "^8.2.3",
    "@valerypopoff/rivet2-node": "workspace:^",
    "chalk": "^5.4.1",
    "didyoumean2": "^7.0.4",
    "dotenv": "^16.4.7",
    "hono": "^4.7.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.29",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "eslint": "^9.20.1",
    "eslint-config-standard-with-typescript": "^39.1.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^16.2.0",
    "eslint-plugin-promise": "^6.1.1",
    "tsx": "^4.6.2",
    "typescript": "^5.7.3"
  },
  "volta": {
    "node": "20.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
