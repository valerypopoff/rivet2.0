# Isolated local Kubernetes rehearsal only. Do not use these credentials or
# settings outside a disposable local Kubernetes installation.
RIVET_KEY=local-rivet-kubernetes-rehearsal-only
RIVET_SERVER_UI_AUTH_MODE=key
RIVET_REQUIRE_UI_GATE_KEY=true

RIVET_K8S_CONTEXT=rivet-restore-local
RIVET_K8S_CLUSTER_PROVIDER=minikube
RIVET_K8S_MINIKUBE_PROFILE=rivet-restore-local
RIVET_K8S_NAMESPACE=rivet-restore-local
RIVET_K8S_RELEASE=rivet-local
RIVET_K8S_PROXY_PORT=8090
RIVET_K8S_PROXY_REPLICAS=2
RIVET_K8S_WEB_REPLICAS=1
RIVET_K8S_EXECUTION_REPLICAS=2

# Opt in to PostgreSQL/MinIO provisioned in this namespace (not cloud services).
RIVET_K8S_LOCAL_MANAGED_SERVICES=true
RIVET_K8S_LOCAL_POSTGRES_DATABASE=rivet
RIVET_K8S_LOCAL_POSTGRES_USER=rivet
RIVET_K8S_LOCAL_POSTGRES_PASSWORD=rivet-local-only
RIVET_K8S_LOCAL_POSTGRES_SIZE=8Gi
RIVET_K8S_LOCAL_MINIO_SIZE=16Gi
# Blank means use the cluster's default dynamic StorageClass.
RIVET_K8S_LOCAL_STORAGE_CLASS=
# URLs are derived from namespace/release and the credentials above. Leave these
# optional overrides unset; if supplied they must match (including the password):
# RIVET_K8S_DATABASE_CONNECTION_STRING=postgresql://rivet:rivet-local-only@rivet-local-postgres.rivet-restore-local.svc.cluster.local:5432/rivet?sslmode=disable
RIVET_K8S_DATABASE_SSL_MODE=disable

RIVET_K8S_STORAGE_BUCKET=rivet-workflows
# RIVET_K8S_STORAGE_ENDPOINT=http://rivet-local-minio.rivet-restore-local.svc.cluster.local:9000
RIVET_K8S_STORAGE_FORCE_PATH_STYLE=true
RIVET_K8S_STORAGE_REGION=us-east-1
RIVET_K8S_STORAGE_ACCESS_KEY_ID=rivet-local-minio
RIVET_K8S_STORAGE_ACCESS_KEY=rivet-local-minio-only
