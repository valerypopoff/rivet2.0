# Isolated local Kubernetes rehearsal only. Do not use these credentials or
# settings outside a disposable local Minikube profile.
RIVET_KEY=local-rivet-kubernetes-rehearsal-only
RIVET_SERVER_UI_AUTH_MODE=none
RIVET_REQUIRE_UI_GATE_KEY=false

RIVET_K8S_CONTEXT=rivet-local
RIVET_K8S_CLUSTER_PROVIDER=minikube
RIVET_K8S_MINIKUBE_PROFILE=rivet-local
RIVET_K8S_NAMESPACE=rivet-local
RIVET_K8S_RELEASE=rivet-local
RIVET_K8S_PROXY_PORT=8090
RIVET_K8S_PROXY_REPLICAS=2
RIVET_K8S_WEB_REPLICAS=1
RIVET_K8S_EXECUTION_REPLICAS=2

RIVET_K8S_DATABASE_CONNECTION_STRING=postgresql://rivet:rivet-local-only@rivet-local-postgres.rivet-local.svc.cluster.local:5432/rivet?sslmode=disable
RIVET_K8S_DATABASE_SSL_MODE=disable

RIVET_K8S_STORAGE_URL=http://rivet-local-minio.rivet-local.svc.cluster.local:9000/rivet-workflows
RIVET_K8S_STORAGE_REGION=us-east-1
RIVET_K8S_STORAGE_ACCESS_KEY_ID=rivet-local-minio
RIVET_K8S_STORAGE_ACCESS_KEY=rivet-local-minio-only
