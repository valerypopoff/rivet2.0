map_hash_bucket_size 128;

resolver ${RIVET_PROXY_RESOLVER} valid=30s ipv6=off;
resolver_timeout 5s;

# Keep resolved peers in shared memory while DNS refreshes in the background.
# A transient resolver failure must not make healthy, known backends unreachable.
# Requires nginx >= 1.27.3 (open-source upstream "resolve" support).
upstream rivet_web {
    zone rivet_web 64k;
    server ${RIVET_WEB_UPSTREAM_HOST}:${RIVET_WEB_UPSTREAM_PORT} resolve;
}
upstream rivet_api {
    zone rivet_api 64k;
    server ${RIVET_API_UPSTREAM_HOST}:${RIVET_API_UPSTREAM_PORT} resolve;
}
upstream rivet_execution {
    zone rivet_execution 64k;
    server ${RIVET_EXECUTION_UPSTREAM_HOST}:${RIVET_EXECUTION_UPSTREAM_PORT} resolve;
}
upstream rivet_executor {
    zone rivet_executor 64k;
    server ${RIVET_EXECUTOR_UPSTREAM_HOST}:${RIVET_EXECUTOR_UPSTREAM_PORT} resolve;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Preserve the browser authority, including a non-default port, so operator
# same-origin checks see the same Host as the request's Origin. HTTP/1.0
# requests without Host retain nginx's normal host fallback.
map $http_host $rivet_request_host {
    default $http_host;
    '' $host;
}

map "${RIVET_TRUST_INCOMING_FORWARDED_HEADERS}:$http_x_forwarded_host" $rivet_forwarded_host {
    default $http_host;
    ~^1:(.+)$ $1;
}


map "${RIVET_TRUST_INCOMING_FORWARDED_HEADERS}:$http_x_forwarded_proto" $rivet_forwarded_proto {
    default $scheme;
    ~^1:(.+)$ $1;
}

include ${RIVET_CLIENT_ADDRESS_INCLUDE_FILE};

# This listener is reachable only inside the proxy Pod. It exposes NGINX's
# intentionally aggregate stub-status counters to the optional exporter
# sidecar; it is not a route on the public proxy listener.
server {
    listen 127.0.0.1:18080;
    server_name localhost;
    access_log off;

    location = /stub_status {
        stub_status;
    }

    location / {
        return 404;
    }
}

server {
    listen ${RIVET_PROXY_INTERNAL_LISTEN};
    server_name _;

    client_max_body_size 100m;
    proxy_set_header X-Rivet-Correlation-Id $request_id;

    set $web_upstream http://rivet_web;
    set $api_upstream http://rivet_api;
    set $execution_upstream http://rivet_execution;
    set $api_ui_auth_upstream http://rivet_api/ui-auth;
    set $api_ui_auth_check_upstream http://rivet_api/ui-auth/check;
    set $api_ui_auth_prompt_upstream http://rivet_api/ui-auth/prompt;
    set $api_latest_debugger_upstream http://rivet_api/ws/latest-debugger;
    set $executor_internal_upstream http://rivet_executor/internal;
    set $executor_upstream http://rivet_executor/;
    set $api_ui_auth_origin http://${RIVET_API_UPSTREAM_HOST}:${RIVET_API_UPSTREAM_PORT}/ui-auth;

    # Private API routes are reachable through cluster Services, never ingress.
    location = /internal { return 404; }
    location ^~ /internal/ { return 404; }

    # Singleton-control HA health belongs to execution. Replicated/bridge and
    # local profiles retain their control-owned health target.
    # Match only these public, read-only API probe paths.
    location ~ ^/(healthz|livez|readyz)$ {
        # Return 405 directly; inherited 401/403 handlers render the UI login page.
        if ($request_method !~ ^(GET|HEAD)$) {
            add_header Allow "GET, HEAD" always;
            return 405;
        }
        proxy_pass ${RIVET_PROXY_HEALTH_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header X-Rivet-Proxy-Auth ${RIVET_PROXY_AUTH_TOKEN};
        proxy_set_header Host $rivet_request_host;
        proxy_connect_timeout 5s;
        proxy_read_timeout 5s;
    }

    # Development refresh is same-origin and uses the normal UI gate. Production
    # web images emit no development events; no source server or unauthenticated
    # port exists.
    location = /__rivet_dev/events {
        auth_request /__rivet_ui_auth_check;
        proxy_pass $web_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $rivet_request_host;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
    }

    location / {
        auth_request /__rivet_ui_auth_check;

        proxy_pass $web_upstream;
        proxy_set_header Host $rivet_request_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $rivet_forwarded_host;
        proxy_set_header X-Forwarded-Proto $rivet_forwarded_proto;
    }

    location @web_with_ui_gate_prompt {
        proxy_pass $api_ui_auth_prompt_upstream;
        proxy_http_version 1.1;
        proxy_set_header X-Rivet-Proxy-Auth ${RIVET_PROXY_AUTH_TOKEN};
        proxy_set_header X-Rivet-Client-IP $rivet_client_ip;
        proxy_set_header X-Rivet-Token-Free-Host "";
        proxy_set_header X-Rivet-Ui-Return-To $request_uri;
        proxy_set_header Host $rivet_request_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $rivet_forwarded_host;
        proxy_set_header X-Forwarded-Proto $rivet_forwarded_proto;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
        proxy_read_timeout 30s;
    }

    location = /__rivet_ui_auth_check {
        internal;
        # auth_request inherits the upload's Content-Length, but forwards no body.
        # Enforce size on the public route, not this bodyless internal subrequest.
        client_max_body_size 0;
        proxy_pass $api_ui_auth_check_upstream;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Rivet-Proxy-Auth ${RIVET_PROXY_AUTH_TOKEN};
        proxy_set_header X-Rivet-Client-IP $rivet_client_ip;
        proxy_set_header X-Rivet-Token-Free-Host "";
        proxy_set_header Host $rivet_request_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $rivet_forwarded_host;
        proxy_set_header X-Forwarded-Proto $rivet_forwarded_proto;
        proxy_read_timeout 30s;
    }

    location = /__rivet_auth {
        proxy_pass $api_ui_auth_upstream;
        proxy_http_version 1.1;
        proxy_set_header X-Rivet-Proxy-Auth ${RIVET_PROXY_AUTH_TOKEN};
        proxy_set_header X-Rivet-Client-IP $rivet_client_ip;
        proxy_set_header X-Rivet-Token-Free-Host "";
        proxy_set_header Host $rivet_request_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $rivet_forwarded_host;
        proxy_set_header X-Forwarded-Proto $rivet_forwarded_proto;
        proxy_read_timeout 30s;
    }

    location /__rivet_auth/ {
        rewrite ^/__rivet_auth/(.*)$ /ui-auth/$1 break;
        proxy_pass $api_upstream;
        proxy_redirect $api_ui_auth_origin/ /__rivet_auth/;
        proxy_http_version 1.1;
        proxy_set_header X-Rivet-Proxy-Auth ${RIVET_PROXY_AUTH_TOKEN};
        proxy_set_header X-Rivet-Client-IP $rivet_client_ip;
        proxy_set_header X-Rivet-Token-Free-Host "";
        proxy_set_header Host $rivet_request_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $rivet_forwarded_host;
        proxy_set_header X-Forwarded-Proto $rivet_forwarded_proto;
        proxy_read_timeout 30s;
    }

    # Dashboard-only stream: this exact location must precede /api/ so
    # nginx does not buffer the long-lived SSE response.
    location = /api/workflows/tree/events {
        auth_request /__rivet_ui_auth_check;

        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Rivet-Proxy-Auth ${RIVET_PROXY_AUTH_TOKEN};
        proxy_set_header X-Rivet-Client-IP $rivet_client_ip;
        proxy_set_header X-Rivet-Token-Free-Host "";
        proxy_set_header Host $rivet_request_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $rivet_forwarded_host;
        proxy_set_header X-Forwarded-Proto $rivet_forwarded_proto;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    location = /api/legacy-restore/upload {
        auth_request /__rivet_ui_auth_check;
        client_max_body_size 10g;
        proxy_request_buffering off;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header X-Rivet-Proxy-Auth ${RIVET_PROXY_AUTH_TOKEN};
        proxy_set_header X-Rivet-Client-IP $rivet_client_ip;
        proxy_set_header X-Rivet-Token-Free-Host "";
        proxy_set_header Host $rivet_request_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $rivet_forwarded_host;
        proxy_set_header X-Forwarded-Proto $rivet_forwarded_proto;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api/ {
        auth_request /__rivet_ui_auth_check;

        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header X-Rivet-Proxy-Auth ${RIVET_PROXY_AUTH_TOKEN};
        proxy_set_header X-Rivet-Client-IP $rivet_client_ip;
        proxy_set_header X-Rivet-Token-Free-Host "";
        proxy_set_header Host $rivet_request_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $rivet_forwarded_host;
        proxy_set_header X-Forwarded-Proto $rivet_forwarded_proto;
        include ${RIVET_PROXY_TIMEOUT_INCLUDE_FILE};
    }

    include ${RIVET_PUBLIC_ROUTES_INCLUDE_FILE};

    location /ws/latest-debugger {
        auth_request /__rivet_ui_auth_check;

        proxy_pass $api_latest_debugger_upstream;
        proxy_http_version 1.1;
        proxy_set_header X-Rivet-Proxy-Auth ${RIVET_PROXY_AUTH_TOKEN};
        proxy_set_header X-Rivet-Client-IP $rivet_client_ip;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $rivet_request_host;
        proxy_set_header X-Forwarded-Host $rivet_forwarded_host;
        proxy_set_header X-Forwarded-Proto $rivet_forwarded_proto;
        proxy_read_timeout 86400s;
    }

    location /ws/executor/owner/ {
        auth_request /__rivet_ui_auth_check;
        proxy_http_version 1.1;
        proxy_set_header X-Rivet-Proxy-Auth ${RIVET_PROXY_AUTH_TOKEN};
        proxy_set_header X-Rivet-Client-IP $rivet_client_ip;
        proxy_set_header X-Rivet-Token-Free-Host "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $rivet_request_host;
        proxy_set_header X-Forwarded-Host $rivet_forwarded_host;
        proxy_set_header X-Forwarded-Proto $rivet_forwarded_proto;
        proxy_pass $api_upstream$request_uri;
        proxy_read_timeout 86400s;
    }

    location /ws/executor/internal {
        auth_request /__rivet_ui_auth_check;

        proxy_pass $executor_internal_upstream;
        proxy_set_header X-Rivet-Proxy-Auth ${RIVET_PROXY_AUTH_TOKEN};
        proxy_set_header X-Rivet-Client-IP $rivet_client_ip;
        proxy_set_header X-Rivet-Token-Free-Host "";
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $rivet_request_host;
        proxy_set_header X-Forwarded-Host $rivet_forwarded_host;
        proxy_set_header X-Forwarded-Proto $rivet_forwarded_proto;
        proxy_read_timeout 86400s;
    }

    location /ws/executor {
        auth_request /__rivet_ui_auth_check;

        proxy_pass $executor_upstream;
        proxy_set_header X-Rivet-Proxy-Auth ${RIVET_PROXY_AUTH_TOKEN};
        proxy_set_header X-Rivet-Client-IP $rivet_client_ip;
        proxy_set_header X-Rivet-Token-Free-Host "";
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $rivet_request_host;
        proxy_set_header X-Forwarded-Host $rivet_forwarded_host;
        proxy_set_header X-Forwarded-Proto $rivet_forwarded_proto;
        proxy_read_timeout 86400s;
    }

    error_page 401 403 = @web_with_ui_gate_prompt;
}
