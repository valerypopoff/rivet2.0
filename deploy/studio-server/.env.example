# Single-host Docker Compose starting point. Copy to the repository root as .env.
# The launchers and Compose supply their own internal ports, image names, and
# service defaults. Configure storage and endpoint policy in App Settings.

# Browser-facing host port (change if 8080 is already in use).
RIVET_PORT=8080

# Durable host folder for workflows, recordings, and runtime libraries.
# Set this to the folder you intend to keep through upgrades.
RIVET_ARTIFACTS_HOST_PATH=../

# UI access: none for a private first-time setup; key or oauth for shared use.
# Configure OAuth provider and admin emails in App Settings before using oauth.
RIVET_SERVER_UI_AUTH_MODE=none

# Shared key for UI key mode and authenticated workflow endpoints. Set a secret
# before enabling key mode or publishing protected endpoints.
RIVET_KEY=
