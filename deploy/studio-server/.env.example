# Shared .env for all six dev/staging/prod × local-storage/external-storage commands.
# Docker Compose is sufficient; Kubernetes is optional and configured separately.
# Local startup appends a missing shared key and tier-specific local credentials.
# RIVET_KEY=<random key of at least 32 characters>
#
# Optional tier overrides (defaults: dev 8080, staging 8082, prod 8083).
# RIVET_DEV_PORT=8080
# RIVET_STAGING_PORT=8082
# RIVET_PROD_PORT=8083
# RIVET_DEV_COMPOSE_PROJECT=rivet-dev-local
# RIVET_STAGING_COMPOSE_PROJECT=rivet-staging-local
# RIVET_PROD_COMPOSE_PROJECT=rivet-prod-local
#
# Local PostgreSQL/MinIO credentials are generated once if absent. Keep them with
# the retained volumes; do not change them to reset an existing installation.
# RIVET_DEV_LOCAL_POSTGRES_PASSWORD=
# RIVET_DEV_LOCAL_S3_ACCESS_KEY_ID=
# RIVET_DEV_LOCAL_S3_SECRET_ACCESS_KEY=
# Equivalent RIVET_STAGING_LOCAL_* and RIVET_PROD_LOCAL_* settings are independent.
#
# External storage: configure the selected tier's own database and S3 scope.
# There is NO production fallback for dev/staging.
# RIVET_DEV_DATABASE_CONNECTION_STRING=postgresql://user:password@dev-db.example:5432/rivet_dev
# RIVET_DEV_DATABASE_SSL_MODE=require
# RIVET_DEV_STORAGE_ENDPOINT=https://s3.amazonaws.com
# RIVET_DEV_STORAGE_BUCKET=rivet-dev
# RIVET_DEV_STORAGE_REGION=us-east-1
# RIVET_DEV_STORAGE_PREFIX=workflows/
# RIVET_DEV_STORAGE_FORCE_PATH_STYLE=false
# RIVET_DEV_STORAGE_ACCESS_KEY_ID=
# RIVET_DEV_STORAGE_ACCESS_KEY=
#
# Repeat those fields with RIVET_STAGING_ or RIVET_PROD_ for the other tiers.
# Each independent installation must have its own PostgreSQL database.
# Production can also read existing RIVET_K8S_* external connection variables
# for compatibility, but no Kubernetes context is required for Docker deployment.
#
# Optional per-tier authentication key instead of shared RIVET_KEY:
# RIVET_DEV_KEY=
# RIVET_STAGING_KEY=
# RIVET_PROD_KEY=
# Optional dedicated settings encryption keys (tier-prefixed overrides supported).
# Keep the original encryption key when restoring encrypted legacy settings.
# RIVET_APP_SETTINGS_ENCRYPTION_KEY=
# RIVET_APP_SETTINGS_ENCRYPTION_KEY_PREVIOUS=
