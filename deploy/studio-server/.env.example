# Docker compose
RIVET_PORT=8080

# Optional Prometheus text endpoint on the direct API container only. The public
# proxy intentionally does not route /metrics; use a private host or Docker/Kubernetes
# network path for scrapes.
# RIVET_METRICS_ENABLED=false

# Published web-app browser-storage RPC v2
#
# Large Stored Values remain in the user's browser. The execution API streams
# only the value requested by a graph and the final action patch over the
# existing WebSocket; it never persists these payloads server-side.
# Defaults:
# - one Stored Value: 256 MiB
# - one action's combined reads and commit: 512 MiB
# - all active transfers reserved by one execution replica: 512 MiB
# - transfer timeout: 60 seconds
# Keep max value <= max action. Size the active limit together with execution
# replica memory and published-execution admission capacity.
# RIVET_WEB_APP_BROWSER_STORAGE_TRANSFER_TIMEOUT_MS=60000
# RIVET_WEB_APP_BROWSER_STORAGE_MAX_VALUE_BYTES=268435456
# RIVET_WEB_APP_BROWSER_STORAGE_MAX_ACTION_BYTES=536870912
# RIVET_WEB_APP_BROWSER_STORAGE_MAX_ACTIVE_BYTES=536870912
# Leave unset for a normal installation. During an in-place upgrade from a
# standalone Studio Server, the production launcher detects one existing
# `ops_rivet_data` or `compose_rivet_data` volume automatically. Set this only
# if both exist and you need to choose the production volume explicitly.
# RIVET_STUDIO_SERVER_COMPOSE_PROJECT=ops

# Fast deploys can pull prebuilt images from GHCR with `yarn studio-server:prod:prebuilt`.
# Leave these unset to use the default published images and the `latest` tag.
# RIVET_IMAGE_TAG=latest
# RIVET_PROXY_IMAGE=ghcr.io/valerypopoff/rivet2.0-studio-server/proxy:latest
# RIVET_WEB_IMAGE=ghcr.io/valerypopoff/rivet2.0-studio-server/web:latest
# RIVET_API_IMAGE=ghcr.io/valerypopoff/rivet2.0-studio-server/api:latest
# RIVET_EXECUTOR_IMAGE=ghcr.io/valerypopoff/rivet2.0-studio-server/executor:latest


# Filesystem artifact root
#
# Canonical local-filesystem bootstrap contract:
# - point RIVET_ARTIFACTS_HOST_PATH at a shared host root
# - the launchers derive:
#   - <root>/workflows
#   - <root>/workflow-recordings
#   - <root>/runtime-libraries
#
# After the app has started, use App Settings -> Storage for the storage mode,
# database mode, managed PostgreSQL settings, and object-storage credentials.
# Saved UI settings live in app data. The API/executor runtime reads that
# settings file, not .env, for storage and database choices.
RIVET_ARTIFACTS_HOST_PATH=../
# Optional explicit override for the API recordings bind mount in Docker modes.
# If unset, the launcher derives <RIVET_ARTIFACTS_HOST_PATH>/workflow-recordings when
# RIVET_ARTIFACTS_HOST_PATH is present.
# RIVET_WORKFLOW_RECORDINGS_HOST_PATH=

# Local Kubernetes rehearsal launcher
#
# `yarn studio-server:dev:kubernetes-test` expects the supported Kubernetes shape:
# - reachable Postgres + S3-compatible storage, either externally managed or
#   deployed inside the disposable local Kubernetes namespace
# - chart-generated deployment-storage settings mounted through app data
#
# Use `yarn studio-server:verify:kubernetes` for the repo-local render/lint check that covers both the
# local rehearsal values path and the production overlay contract.
#
# Required managed-service inputs for that launcher:
# RIVET_K8S_DATABASE_CONNECTION_STRING=postgresql://db-user:db-pass@example-db:5432/rivet?sslmode=require
# RIVET_K8S_STORAGE_URL=https://my-bucket.s3.us-east-1.amazonaws.com
# or the explicit tuple below:
# RIVET_K8S_STORAGE_BUCKET=my-bucket
# RIVET_K8S_STORAGE_REGION=us-east-1
# RIVET_K8S_STORAGE_ENDPOINT=
# RIVET_K8S_STORAGE_ACCESS_KEY_ID=
# RIVET_K8S_STORAGE_ACCESS_KEY=
# RIVET_K8S_STORAGE_FORCE_PATH_STYLE=false
#
# Optional launcher-only overrides:
# RIVET_K8S_CONTEXT=minikube
# RIVET_K8S_CLUSTER_PROVIDER=minikube
# RIVET_K8S_MINIKUBE_PROFILE=minikube
# RIVET_K8S_MINIKUBE_BIN=minikube
# RIVET_K8S_CLUSTER_DOMAIN=cluster.local
# RIVET_K8S_NAMESPACE=rivet-local
# RIVET_K8S_RELEASE=rivet-local
# RIVET_K8S_PROXY_PORT=8080
# RIVET_PROXY_RESOLVER may be a Kubernetes DNS service hostname; the proxy entrypoint resolves it to IPs before nginx starts.
# RIVET_K8S_PROXY_REPLICAS=2
# RIVET_K8S_WEB_REPLICAS=1
# RIVET_K8S_EXECUTION_REPLICAS=2
# RIVET_K8S_LOAD_LOCAL_IMAGES=true
# RIVET_K8S_IMAGE_TAG=
#
# For a completely self-contained Minikube rehearsal, copy
# deploy/studio-server/.env.kubernetes-local.example to .env.local and apply
# deploy/studio-server/kubernetes-test/local-dependencies.yaml first. The
# credentials in that dedicated template are intentionally disposable and must
# never be used outside the local cluster.

## Optional local-docker managed-service defaults used by the Docker stacks
## Diagnostic Postgres/MinIO/API host ports bind to localhost by default.
## Set RIVET_LOCAL_BIND_HOST=0.0.0.0 only on a trusted/firewalled network.
# RIVET_LOCAL_BIND_HOST=127.0.0.1
# RIVET_WORKFLOWS_LOCAL_DOCKER_POSTGRES_DB=rivet
# RIVET_WORKFLOWS_LOCAL_DOCKER_POSTGRES_USER=rivet
# RIVET_WORKFLOWS_LOCAL_DOCKER_POSTGRES_PASSWORD=rivet
# RIVET_WORKFLOWS_LOCAL_DOCKER_POSTGRES_PORT=54329
# RIVET_WORKFLOWS_LOCAL_DOCKER_OBJECT_STORAGE_BUCKET=rivet-workflows
# RIVET_WORKFLOWS_LOCAL_DOCKER_OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
# RIVET_WORKFLOWS_LOCAL_DOCKER_OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
# RIVET_WORKFLOWS_LOCAL_DOCKER_OBJECT_STORAGE_PORT=9000
# RIVET_WORKFLOWS_LOCAL_DOCKER_OBJECT_STORAGE_CONSOLE_PORT=9001

# Runtime-library sync behavior in managed mode
#
# Runtime libraries follow Settings -> Storage:
# - Local folders:   local runtime-libraries/ under RIVET_ARTIFACTS_HOST_PATH
# - Object storage:  Postgres + object storage, with immutable artifacts under runtime-libraries/
# Optional poll interval for background reconciliation in managed mode:
# RIVET_RUNTIME_LIBRARIES_SYNC_POLL_INTERVAL_MS=5000
# Optional stale-replica retention and cleanup cadence for replica-readiness reporting.
# Defaults:
# - local-docker: retain stale rows for 24h, clean every 15m
# - managed: retain stale rows for 15m, clean every 5m
# RIVET_RUNTIME_LIBRARIES_REPLICA_STATUS_RETENTION_MS=900000
# RIVET_RUNTIME_LIBRARIES_REPLICA_STATUS_CLEANUP_INTERVAL_MS=300000
# Optional explicit process role for managed replica-readiness reporting.
# The official API/executor images and compose stacks set this automatically.
# RIVET_RUNTIME_PROCESS_ROLE=api

# Filesystem recording storage
#
# In filesystem mode:
# - live projects and .published snapshots stay under RIVET_WORKFLOWS_ROOT
# - recording bundles may be split onto a separate root with RIVET_WORKFLOW_RECORDINGS_ROOT
# - recordings.sqlite stays under RIVET_APP_DATA_ROOT
#
# Docker stacks set RIVET_WORKFLOW_RECORDINGS_ROOT=/workflow-recordings automatically.
# Host migration example:
#   New-Item -ItemType Directory -Force D:\Programming\workflow-recordings
#   robocopy D:\Programming\workflows\.recordings D:\Programming\workflow-recordings /E /MOVE
# RIVET_WORKFLOW_RECORDINGS_ROOT=
#
# Security settings

## Server UI access mode:
## - none: no built-in gate for the editor/dashboard UI
## - key: ask for RIVET_KEY in the browser
## - oauth: redirect editor/dashboard visitors through the provider saved in Settings -> OAuth
##          and the admin emails saved in Settings -> Server UI access
RIVET_SERVER_UI_AUTH_MODE=none

## Whether the proxy should trust incoming X-Forwarded-Host / X-Forwarded-Proto.
## Keep false unless a trusted upstream ingress strips and rewrites those headers.
RIVET_TRUST_INCOMING_FORWARDED_HEADERS=true

## Shared key for proxy/API trust, workflow bearer auth, and server UI key mode.
RIVET_KEY=

## Bootstrap flow for server UI OAuth:
## 1. Start with RIVET_SERVER_UI_AUTH_MODE=none or key.
## 2. Open Settings -> OAuth and save the shared OAuth provider
##    settings.
## 3. Open Settings -> Server UI access and save Server UI admin emails.
## 4. Register this callback with the OAuth provider:
##    https://your-host/__rivet_auth/oauth/callback
## 5. Change RIVET_SERVER_UI_AUTH_MODE=oauth and restart/recreate the API.

## Optional comma-separated browser origins allowed to make credentialed CORS requests.
## Same-origin browser requests are allowed automatically; leave empty for public deployments.
RIVET_CORS_ALLOWED_ORIGINS=

## Runtime policy such as public route slugs, workflow endpoint auth,
## trusted hosts, web-app auth, OAuth provider settings, recording limits,
## node-executor proxy values, and HTTP/runtime limits is configured in the
## app Settings modal and stored under RIVET_APP_DATA_ROOT.

## Latest remote debugger is enabled by default for latest workflow and web-app runs.
## Advanced hardening override:
## RIVET_ENABLE_LATEST_REMOTE_DEBUGGER=false

## Runtime websocket defaults are derived from the incoming request host.
## Optional Node executor and Remote Debugger websocket URL overrides are configured
## in App Settings -> Node executor proxy -> Websocket URL overrides.



VITE_RIVET_DEBUG_LOGS=false
RIVET_WEB_BUILD_MAX_OLD_SPACE_SIZE=4096
# Browser clients should use the proxy-relative API route.
VITE_RIVET_API_BASE_URL=/api

# API ports
# Host port exposed by the Docker dev stack.
# Docker maps this host port to port 80 inside the API container.
RIVET_API_PORT=3100

# Port used when running the API service directly outside Docker.
# This is the API port only.
# In Docker, compose overrides the API container to PORT=80 and pins the executor
# container separately to port 21889.
PORT=3100

# Internal executor websocket port for the production image entrypoint.
# Leave this at 21889 unless you also update the proxy upstreams and websocket routes.
RIVET_EXECUTOR_PORT=21889

# RIVET_NODE_EXECUTOR_PROXY_SETTINGS_POLL_INTERVAL_MS=5000

# API service
# Optional overrides. Leave unset to use self-contained defaults:
# - workspace root -> repo root
# - app data root  -> <repo>/.data/rivet-app
# RIVET_WORKSPACE_ROOT=
# RIVET_APP_DATA_ROOT=

# Optional extra env vars that Browser-executor code may read via /api/config/env/:name.
# Node/headless execution receives the selected launcher dotenv server-side and does not
# need this allowlist. Default browser allowlist already includes OPENAI_API_KEY,
# OPENAI_ORG_ID, and OPENAI_ENDPOINT. Never browser-allowlist server credentials.
# RIVET_ENV_ALLOWLIST=

# Optional key for Pinecone Knowledge Stores, including Sync Knowledge Source.
# Like arbitrary LLM credential aliases, Docker passes it only to the API and Node
# executor containers, never to the browser.
# PINECONE_API_KEY=

# Optional extra shell programs the hosted API may execute.
# Default allowlist already includes git and pnpm.
# RIVET_SHELL_ALLOWLIST=

# Optional extra filesystem roots the hosted API may access.
# Use this to allow file operations outside the workspace, app data, and workflows roots.
# Provide a comma-separated list of absolute paths, for example:
# RIVET_EXTRA_ROOTS=D:\SharedAssets,D:\ModelFiles
