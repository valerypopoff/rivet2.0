# Production-only subset of .env.example; copy to the shared .env, not a second file.
RIVET_K8S_CONTEXT=your-production-context
RIVET_K8S_NAMESPACE=rivet
RIVET_K8S_RELEASE=rivet
RIVET_KEY=replace-with-a-random-key-of-at-least-32-characters
RIVET_SERVER_UI_AUTH_MODE=key
RIVET_REQUIRE_UI_GATE_KEY=true
RIVET_K8S_DATABASE_CONNECTION_STRING=postgresql://rivet:replace-password@database.example:5432/rivet
RIVET_K8S_DATABASE_SSL_MODE=require
RIVET_K8S_STORAGE_ENDPOINT=https://s3.amazonaws.com
RIVET_K8S_STORAGE_BUCKET=your-rivet-bucket
RIVET_K8S_STORAGE_REGION=us-east-1
RIVET_K8S_STORAGE_PREFIX=workflows/
RIVET_K8S_STORAGE_ACCESS_KEY_ID=replace-access-key
RIVET_K8S_STORAGE_ACCESS_KEY=replace-secret-key
RIVET_K8S_STORAGE_FORCE_PATH_STYLE=false
RIVET_K8S_EXECUTION_REPLICAS=2
