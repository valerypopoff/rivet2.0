        {
          "expr": "max by (domain) (rivet_managed_reconciliation_open_findings{profile=\"control\"})",
          "legendFormat": "{{domain}}",
          "refId": "A"
        }
      ],
      "title": "Open reconciliation findings",
      "type": "timeseries"
    }
