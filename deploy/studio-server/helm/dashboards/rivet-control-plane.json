      "id": 1,
      "targets": [
        {
          "expr": "max by (pod) (rivet_runtime_readiness{profile=\"control\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "Control API readiness",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "time() - max(rivet_managed_maintenance_last_success_timestamp_seconds{profile=\"control\"})",
          "legendFormat": "seconds since last success",
          "refId": "A"
        }
      ],
      "title": "Maintenance freshness",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (state) (rivet_managed_object_deletion_outbox_entries{profile=\"control\"})",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
