# Private file: choose fresh credentials before the first installation.
# Install K3s on this VM and use its kubeconfig; the launcher does not install,
# upgrade, uninstall or delete Kubernetes itself.
RIVET_K8S_CONTEXT=default
RIVET_K8S_CLUSTER_PROVIDER=k3s
RIVET_K8S_RELEASE=rivet
RIVET_K8S_NAMESPACE=rivet
RIVET_K8S_LOCAL_MANAGED_SERVICES=true
RIVET_KEY=replace-with-a-random-key-of-at-least-32-characters
RIVET_SERVER_UI_AUTH_MODE=key
RIVET_REQUIRE_UI_GATE_KEY=true
RIVET_K8S_LOCAL_POSTGRES_DATABASE=rivet
RIVET_K8S_LOCAL_POSTGRES_USER=rivet
RIVET_K8S_LOCAL_POSTGRES_PASSWORD=replace-with-a-random-database-password
RIVET_K8S_LOCAL_POSTGRES_SIZE=16Gi
RIVET_K8S_LOCAL_MINIO_SIZE=32Gi
RIVET_K8S_LOCAL_STORAGE_CLASS=local-path
RIVET_K8S_DATABASE_SSL_MODE=disable
RIVET_K8S_STORAGE_BUCKET=rivet
RIVET_K8S_STORAGE_REGION=us-east-1
RIVET_K8S_STORAGE_ACCESS_KEY_ID=rivet
RIVET_K8S_STORAGE_ACCESS_KEY=replace-with-a-random-minio-password
RIVET_K8S_STORAGE_FORCE_PATH_STYLE=true
