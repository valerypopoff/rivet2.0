map_hash_bucket_size 128;

resolver ${RIVET_PROXY_RESOLVER} valid=30s ipv6=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

map "${RIVET_TRUST_INCOMING_FORWARDED_HEADERS}:$http_x_forwarded_host" $rivet_forwarded_host {
    default $http_host;
    ~^1:(.+)$ $1;
}

map $rivet_forwarded_host $rivet_forwarded_hostname {
    default $rivet_forwarded_host;
    ~^\[(?<ipv6_host>[^\]]+)\](?::\d+)?$ $ipv6_host;
    ~^(?<plain_host>[^:]+):\d+$ $plain_host;
}

map "${RIVET_TRUST_INCOMING_FORWARDED_HEADERS}:$http_x_forwarded_proto" $rivet_forwarded_proto {
    default $scheme;
    ~^1:(.+)$ $1;
}

map $rivet_forwarded_hostname $rivet_ui_host_is_token_free {
    default 0;
    ~${RIVET_UI_TOKEN_FREE_HOSTS_REGEX} 1;
}

map $cookie_rivet_ui_token $rivet_ui_has_valid_cookie_token {
    default 0;
    "${RIVET_UI_SESSION_TOKEN}" 1;
}

map $rivet_forwarded_proto $rivet_ui_cookie_secure_suffix {
    default "";
    ~*^https$ "; Secure";
}

map "${RIVET_REQUIRE_UI_GATE_KEY}" $rivet_ui_gate_enabled {
    default 0;
    "1" 1;
}

map "${RIVET_UI_GATE_KEY_PRESENT}" $rivet_ui_gate_has_key {
    default 0;
    "1" 1;
}

map "$rivet_ui_gate_enabled:$rivet_ui_gate_has_key:$rivet_ui_host_is_token_free:$rivet_ui_has_valid_cookie_token" $rivet_ui_gate_result {
    default allow;
    "1:0:0:0" deny;
    "1:0:0:1" deny;
    "1:0:1:0" allow;
    "1:0:1:1" allow;
    "1:1:0:0" deny;
    "1:1:0:1" allow;
    "1:1:1:0" allow;
    "1:1:1:1" allow;
}

map "${RIVET_WEB_APPS_AUTH_MODE}" $rivet_web_apps_use_ui_gate {
    default 1;
    "oauth" 0;
    "none" 0;
}

map "$rivet_web_apps_use_ui_gate:$rivet_ui_gate_result" $rivet_web_apps_gate_result {
    default allow;
    "1:deny" deny;
}

server {
    listen 8080;
    server_name _;

    client_max_body_size 100m;

    set $web_upstream http://${RIVET_WEB_UPSTREAM_HOST}:${RIVET_WEB_UPSTREAM_PORT};
    set $api_upstream http://${RIVET_API_UPSTREAM_HOST}:${RIVET_API_UPSTREAM_PORT};
    set $execution_upstream http://${RIVET_EXECUTION_UPSTREAM_HOST}:${RIVET_EXECUTION_UPSTREAM_PORT};
    set $api_ui_auth_upstream http://${RIVET_API_UPSTREAM_HOST}:${RIVET_API_UPSTREAM_PORT}/ui-auth;
    set $api_latest_debugger_upstream http://${RIVET_API_UPSTREAM_HOST}:${RIVET_API_UPSTREAM_PORT}/ws/latest-debugger;
    set $executor_internal_upstream http://${RIVET_EXECUTOR_UPSTREAM_HOST}:${RIVET_EXECUTOR_UPSTREAM_PORT}/internal;
    set $executor_upstream http://${RIVET_EXECUTOR_UPSTREAM_HOST}:${RIVET_EXECUTOR_UPSTREAM_PORT}/;

    location / {
        if ($rivet_ui_gate_result = deny) {
            return 401;
        }

        if ($rivet_ui_gate_result = allow_with_cookie) {
            return 418;
        }

        proxy_pass $web_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $rivet_forwarded_host;
        proxy_set_header X-Forwarded-Proto $rivet_forwarded_proto;
    }

    location @web_with_token_cookie {
        add_header Set-Cookie "rivet_ui_token=${RIVET_UI_SESSION_TOKEN}; Path=/; HttpOnly; SameSite=Lax$rivet_ui_cookie_secure_suffix" always;
        proxy_pass $web_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $rivet_forwarded_host;
        proxy_set_header X-Forwarded-Proto $rivet_forwarded_proto;
    }

    location @web_with_ui_gate_prompt {
        internal;
        default_type text/html;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
        root /tmp/nginx/html;
        try_files /ui-gate-prompt.html =500;
    }

    location = /__rivet_auth {
        proxy_pass $api_ui_auth_upstream;
        proxy_http_version 1.1;
        proxy_set_header X-Rivet-Proxy-Auth ${RIVET_PROXY_AUTH_TOKEN};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $rivet_forwarded_host;
        proxy_set_header X-Forwarded-Proto $rivet_forwarded_proto;
        proxy_read_timeout 30s;
    }

    location /api/ {
        if ($rivet_ui_gate_result = deny) {
            return 403;
        }

        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header X-Rivet-Proxy-Auth ${RIVET_PROXY_AUTH_TOKEN};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $rivet_forwarded_host;
        proxy_set_header X-Forwarded-Proto $rivet_forwarded_proto;
        proxy_read_timeout ${RIVET_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${RIVET_PROXY_READ_TIMEOUT};
    }

    location ${RIVET_PUBLISHED_WORKFLOWS_BASE_PATH}/ {
        proxy_pass $execution_upstream;
        proxy_http_version 1.1;
        proxy_set_header X-Rivet-Proxy-Auth ${RIVET_PROXY_AUTH_TOKEN};
        proxy_set_header X-Rivet-Token-Free-Host $rivet_ui_host_is_token_free;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $rivet_forwarded_host;
        proxy_set_header X-Forwarded-Proto $rivet_forwarded_proto;
        proxy_read_timeout ${RIVET_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${RIVET_PROXY_READ_TIMEOUT};
    }

    location ${RIVET_WEB_APPS_BASE_PATH}/ {
        if ($rivet_web_apps_gate_result = deny) {
            return 401;
        }

        proxy_pass $execution_upstream;
        proxy_http_version 1.1;
        proxy_set_header X-Rivet-Proxy-Auth ${RIVET_PROXY_AUTH_TOKEN};
        proxy_set_header X-Rivet-Token-Free-Host $rivet_ui_host_is_token_free;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $rivet_forwarded_host;
        proxy_set_header X-Forwarded-Proto $rivet_forwarded_proto;
        proxy_read_timeout ${RIVET_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${RIVET_PROXY_READ_TIMEOUT};
    }

    location ${RIVET_LATEST_WORKFLOWS_BASE_PATH}/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header X-Rivet-Proxy-Auth ${RIVET_PROXY_AUTH_TOKEN};
        proxy_set_header X-Rivet-Token-Free-Host $rivet_ui_host_is_token_free;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $rivet_forwarded_host;
        proxy_set_header X-Forwarded-Proto $rivet_forwarded_proto;
        proxy_read_timeout ${RIVET_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${RIVET_PROXY_READ_TIMEOUT};
    }

    location ${RIVET_LATEST_WEB_APPS_BASE_PATH}/ {
        if ($rivet_web_apps_gate_result = deny) {
            return 401;
        }

        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header X-Rivet-Proxy-Auth ${RIVET_PROXY_AUTH_TOKEN};
        proxy_set_header X-Rivet-Token-Free-Host $rivet_ui_host_is_token_free;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $rivet_forwarded_host;
        proxy_set_header X-Forwarded-Proto $rivet_forwarded_proto;
        proxy_read_timeout ${RIVET_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${RIVET_PROXY_READ_TIMEOUT};
    }

    location /ws/latest-debugger {
        if ($rivet_ui_gate_result = deny) {
            return 403;
        }

        proxy_pass $api_latest_debugger_upstream;
        proxy_http_version 1.1;
        proxy_set_header X-Rivet-Proxy-Auth ${RIVET_PROXY_AUTH_TOKEN};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $rivet_forwarded_host;
        proxy_set_header X-Forwarded-Proto $rivet_forwarded_proto;
        proxy_read_timeout 86400s;
    }

    location /ws/executor/internal {
        if ($rivet_ui_gate_result = deny) {
            return 403;
        }

        proxy_pass $executor_internal_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $rivet_forwarded_host;
        proxy_set_header X-Forwarded-Proto $rivet_forwarded_proto;
        proxy_read_timeout 86400s;
    }

    location /ws/executor {
        if ($rivet_ui_gate_result = deny) {
            return 403;
        }

        proxy_pass $executor_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $rivet_forwarded_host;
        proxy_set_header X-Forwarded-Proto $rivet_forwarded_proto;
        proxy_read_timeout 86400s;
    }

    error_page 401 = @web_with_ui_gate_prompt;
    error_page 418 = @web_with_token_cookie;
}
